#!/usr/bin/env python3
"""Small mpv IPC controller for the nghtwv plz Omarchy widget."""

import fcntl
import hashlib
import json
import os
import re
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path


STREAM_URL = "https://radio.plaza.one/mp3"
STATUS_URL = "https://api.plaza.one/status"
HISTORY_URL = "https://api.plaza.one/history"
HISTORY_LIMIT = 10
BACKGROUNDS_URL = "https://api.plaza.one/v2/backgrounds/random"
PLUGIN_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "omarchy-nightwave-plaza"
SOCKET_PATH = PLUGIN_DIR / "mpv.sock"
SETTINGS_PATH = PLUGIN_DIR / "settings.json"
LOCK_PATH = PLUGIN_DIR / "player.lock"
PID_PATH = PLUGIN_DIR / "player.pid"
SINK_NAME_RE = re.compile(r"[A-Za-z0-9._:+-]{1,160}\Z")
MAX_STATUS_BYTES = 256 * 1024

# Backdrop validation limits (owned by plaza-player; initial defaults).
BACKGROUND_CACHE_DIR = PLUGIN_DIR / "backgrounds"
BACKGROUND_CACHE_INDEX = PLUGIN_DIR / "backgrounds.json"
MAX_IMAGE_BYTES = 8 * 1024 * 1024
IMAGE_TIMEOUT = 10
MAX_CANVAS_WIDTH = 1920
MAX_CANVAS_HEIGHT = 1080
MAX_FRAMES = 60
MAX_AGGREGATE_PIXELS = 16 * 1024 * 1024
GIF_SIGNATURES = (b"GIF87a", b"GIF89a")


def request(command, timeout=1.5):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(timeout)
        client.connect(str(SOCKET_PATH))
        client.sendall((json.dumps({"command": command, "request_id": 1}) + "\n").encode())
        buffer = b""
        while len(buffer) < 65536:
            chunk = client.recv(4096)
            if not chunk:
                break
            buffer += chunk
            while b"\n" in buffer:
                line, buffer = buffer.split(b"\n", 1)
                try:
                    response = json.loads(line)
                except (UnicodeDecodeError, json.JSONDecodeError):
                    continue
                if response.get("request_id") == 1:
                    if response.get("error") != "success":
                        raise RuntimeError(response.get("error", "mpv command failed"))
                    return response.get("data")
    raise RuntimeError("No response from mpv")


def get_property(name, default=None):
    try:
        return request(["get_property", name])
    except (OSError, RuntimeError, TimeoutError):
        return default


def load_settings():
    try:
        with open(SETTINGS_PATH, encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def save_settings(settings):
    PLUGIN_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = SETTINGS_PATH.with_suffix(".tmp")
    with open(temporary, "w", encoding="utf-8") as handle:
        json.dump(settings, handle)
    os.replace(temporary, SETTINGS_PATH)


def configured_output():
    output = load_settings().get("output")
    if isinstance(output, str) and SINK_NAME_RE.match(output):
        return output
    return ""


def list_sinks():
    try:
        completed = subprocess.run(
            ["pactl", "-f", "json", "list", "sinks"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        raise RuntimeError("Audio outputs are unavailable")
    if completed.returncode != 0:
        raise RuntimeError("Audio outputs are unavailable")
    try:
        sinks = json.loads(completed.stdout.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise RuntimeError("Audio outputs are unavailable")
    if not isinstance(sinks, list):
        raise RuntimeError("Audio outputs are unavailable")
    return sinks


def sink_exists(name):
    try:
        sinks = list_sinks()
    except RuntimeError:
        return False
    return any(isinstance(sink, dict) and sink.get("name") == name for sink in sinks)


def outputs():
    entries = []
    for sink in list_sinks():
        if not isinstance(sink, dict):
            continue
        name = sink.get("name")
        if not isinstance(name, str) or not SINK_NAME_RE.match(name):
            continue
        label = sink.get("description")
        if not isinstance(label, str) or not label.strip():
            label = name
        entries.append({"id": name, "label": clean_text(label)})
    print(json.dumps({"outputs": entries}, ensure_ascii=True))


def set_output(requested):
    requested = requested or ""
    if requested and not SINK_NAME_RE.match(requested):
        raise RuntimeError("Unknown audio output")
    if requested and not sink_exists(requested):
        raise RuntimeError("Unknown audio output")
    device = "auto" if not requested else "pipewire/" + requested
    alive = False
    if SOCKET_PATH.exists():
        try:
            request(["get_property", "idle-active"])
            alive = True
        except (OSError, RuntimeError, TimeoutError):
            alive = False
    if alive:
        try:
            request(["set_property", "audio-device", device])
        except (OSError, RuntimeError, TimeoutError):
            raise RuntimeError("Audio output could not be changed")
    settings = load_settings()
    settings["output"] = requested
    save_settings(settings)
    print(json.dumps(state(), ensure_ascii=True))


def launch(play_stream=True):
    PLUGIN_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock_fd = os.open(str(LOCK_PATH), os.O_CREAT | os.O_RDWR, 0o600)
    fcntl.flock(lock_fd, fcntl.LOCK_EX)
    try:
        if SOCKET_PATH.exists():
            try:
                request(["get_property", "idle-active"])
                return
            except (OSError, RuntimeError, TimeoutError):
                SOCKET_PATH.unlink(missing_ok=True)
                PID_PATH.unlink(missing_ok=True)

        command = [
            "mpv",
            "--no-video",
            "--force-window=no",
            "--idle=yes",
            "--input-ipc-server=" + str(SOCKET_PATH),
            "--title=nghtwv plz",
            # MPRIS clients read media-title; the station name bridges the gap
            # until the first metadata poll publishes the track.
            "--force-media-title=Nightwave Plaza",
            "--volume=70",
            "--network-timeout=30",
            "--cache-secs=20",
            "--demuxer-max-bytes=8MiB",
            "--demuxer-max-back-bytes=2MiB",
        ]
        remembered = configured_output()
        if remembered and sink_exists(remembered):
            command.append("--audio-device=pipewire/" + remembered)
        if play_stream:
            command.append(STREAM_URL)
        process = subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )

        with open(PID_PATH, "w", encoding="utf-8") as handle:
            handle.write(str(process.pid))

        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            try:
                request(["get_property", "idle-active"], timeout=0.3)
                return
            except (OSError, RuntimeError, TimeoutError):
                time.sleep(0.05)
        raise RuntimeError("mpv did not start; install mpv and check its runtime directory")
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)
        os.close(lock_fd)


def start_stream():
    try:
        idle = request(["get_property", "idle-active"])
    except (OSError, RuntimeError, TimeoutError):
        launch()
        return
    if idle:
        request(["loadfile", STREAM_URL, "replace"])
    request(["set_property", "pause", False])


def toggle():
    try:
        idle = request(["get_property", "idle-active"])
        if idle:
            request(["loadfile", STREAM_URL, "replace"])
        else:
            paused = bool(request(["get_property", "pause"]))
            request(["set_property", "pause", not paused])
    except (OSError, RuntimeError, TimeoutError):
        launch()


def stop():
    killed = False
    try:
        request(["quit"])
        killed = True
    except (OSError, RuntimeError, TimeoutError):
        pass
    if not killed and PID_PATH.exists():
        try:
            with open(PID_PATH, encoding="utf-8") as handle:
                pid = int(handle.read().strip())
        except (ValueError, OSError):
            pid = None
        if pid is not None:
            try:
                with open(f"/proc/{pid}/cmdline", "rb") as handle:
                    cmdline = handle.read().decode("utf-8", errors="replace")
                if str(SOCKET_PATH) in cmdline:
                    os.kill(pid, signal.SIGTERM)
                    try:
                        os.waitpid(pid, 0)
                    except ChildProcessError:
                        pass
            except (OSError, ProcessLookupError, FileNotFoundError):
                pass
        PID_PATH.unlink(missing_ok=True)


def current_output():
    device = get_property("audio-device", "auto")
    if not isinstance(device, str):
        return ""
    if device.startswith("pipewire/"):
        device = device[len("pipewire/"):]
    if device == "auto" or not SINK_NAME_RE.match(device):
        return ""
    return device


def state():
    if not SOCKET_PATH.exists():
        return {"playing": False, "paused": False, "buffering": False, "volume": 70, "title": "", "output": configured_output()}
    try:
        idle = bool(request(["get_property", "idle-active"]))
        paused = bool(get_property("pause", False))
        buffering = bool(get_property("paused-for-cache", False))
        title = get_property("media-title", "")
        volume = get_property("volume", 70)
        return {
            "playing": not idle,
            "paused": paused,
            "buffering": buffering,
            "volume": max(0, min(100, round(float(volume)))),
            "title": str(title or ""),
            "output": current_output(),
        }
    except (OSError, RuntimeError, TimeoutError, TypeError, ValueError):
        return {"playing": False, "paused": False, "buffering": False, "volume": 70, "title": "", "output": configured_output()}


def find_value(value, names):
    if isinstance(value, dict):
        for key, child in value.items():
            if key.lower() in names and isinstance(child, (str, int, float)):
                return child
        for child in value.values():
            found = find_value(child, names)
            if found is not None:
                return found
    elif isinstance(value, list):
        for child in value:
            found = find_value(child, names)
            if found is not None:
                return found
    return None


def clean_text(value, limit=160):
    if not isinstance(value, str):
        return ""
    return " ".join(value.split())[:limit]


def is_remote_url(value):
    """Report whether `value` is a plain HTTPS URL string."""
    return isinstance(value, str) and value.startswith("https://")


class HttpsOnlyRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Follow redirects only when the target remains HTTPS."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not newurl.startswith("https://"):
            raise urllib.error.HTTPError(
                newurl, code, "non-HTTPS redirect is not allowed", headers, None
            )
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def fetch_image(url):
    """Download an image over HTTPS with redirect enforcement and size limits.

    Returns the raw bytes. Raises RuntimeError on any policy violation.
    """
    if not is_remote_url(url):
        raise RuntimeError("image URL must be HTTPS")
    opener = urllib.request.build_opener(HttpsOnlyRedirectHandler)
    request_obj = urllib.request.Request(
        url,
        headers={
            "User-Agent": "omarchy-nightwave-plaza/0.1",
            "Accept": "image/gif",
        },
    )
    with opener.open(request_obj, timeout=IMAGE_TIMEOUT) as response:
        chunks = []
        total = 0
        while True:
            chunk = response.read(65536)
            if not chunk:
                break
            total += len(chunk)
            if total > MAX_IMAGE_BYTES:
                raise RuntimeError("image download exceeds size limit")
            chunks.append(chunk)
    return b"".join(chunks)


def validate_gif(data):
    """Validate GIF structure and resource limits.

    Returns (canvas_width, canvas_height, frame_count). Raises RuntimeError
    for malformed or over-budget GIFs.
    """
    if len(data) < 13:
        raise RuntimeError("image is too small to be a GIF")
    if data[:6] not in GIF_SIGNATURES:
        raise RuntimeError("not a GIF image")

    # Logical Screen Descriptor (bytes 6-12).
    canvas_width = int.from_bytes(data[6:8], "little")
    canvas_height = int.from_bytes(data[8:10], "little")
    packed = data[10]
    if canvas_width == 0 or canvas_height == 0:
        raise RuntimeError("GIF canvas has zero dimensions")
    if canvas_width > MAX_CANVAS_WIDTH or canvas_height > MAX_CANVAS_HEIGHT:
        raise RuntimeError("GIF canvas exceeds dimension limit")

    # Skip Global Color Table if present.
    offset = 13
    if packed & 0x80:
        color_table_entries = 2 ** ((packed & 0x07) + 1)
        offset += color_table_entries * 3

    frame_count = 0
    while offset < len(data):
        block_type = data[offset]
        if block_type == 0x3B:  # Trailer
            break
        elif block_type == 0x21:  # Extension
            if offset + 2 >= len(data):
                raise RuntimeError("truncated GIF extension")
            offset += 2  # introducer + label
            terminated = False
            while offset < len(data):
                sub_size = data[offset]
                if sub_size == 0:
                    offset += 1
                    terminated = True
                    break
                if offset + 1 + sub_size > len(data):
                    raise RuntimeError("truncated GIF sub-block")
                offset += 1 + sub_size
            if not terminated:
                raise RuntimeError("truncated GIF extension (no terminator)")
        elif block_type == 0x2C:  # Image Descriptor (one frame)
            if offset + 10 > len(data):
                raise RuntimeError("truncated GIF image descriptor")
            frame_count += 1
            if frame_count > MAX_FRAMES:
                raise RuntimeError("GIF exceeds frame limit")
            frame_packed = data[offset + 9]
            offset += 10  # descriptor header (separator + 4 fields + packed)
            if frame_packed & 0x80:
                lct_entries = 2 ** ((frame_packed & 0x07) + 1)
                offset += lct_entries * 3
            terminated = False
            while offset < len(data):
                sub_size = data[offset]
                if sub_size == 0:
                    offset += 1
                    terminated = True
                    break
                if offset + 1 + sub_size > len(data):
                    raise RuntimeError("truncated GIF image data")
                offset += 1 + sub_size
            if not terminated:
                raise RuntimeError("truncated GIF image data (no terminator)")
        else:
            raise RuntimeError(f"unknown GIF block type 0x{block_type:02x}")
    else:
        # Loop exited without hitting the trailer: no terminator found.
        raise RuntimeError("GIF has no trailer")

    if offset + 1 != len(data):
        # Trailer must be the final byte; junk after it is rejected.
        raise RuntimeError("GIF has trailing data after trailer")

    if frame_count == 0:
        raise RuntimeError("GIF has no frames")

    # Aggregate canvas pixels across frames.
    aggregate = canvas_width * canvas_height * frame_count
    if aggregate > MAX_AGGREGATE_PIXELS:
        raise RuntimeError("GIF aggregate pixel budget exceeded")

    return canvas_width, canvas_height, frame_count


def load_background_cache():
    try:
        with open(BACKGROUND_CACHE_INDEX, encoding="utf-8") as handle:
            data = json.load(handle)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_background_cache(cache):
    try:
        BACKGROUND_CACHE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
        temporary = BACKGROUND_CACHE_INDEX.with_suffix(".tmp")
        with open(temporary, "w", encoding="utf-8") as handle:
            json.dump(cache, handle)
        os.replace(temporary, BACKGROUND_CACHE_INDEX)
    except OSError as error:
        print(f"nightwave: could not write background cache index: {error}", file=sys.stderr)


def lookup_cached_background(saved, api_src, cache):
    """Return a validated local-file background dict, or None.

    `saved` is the cleaned settings entry; `api_src` is the original API URL
    kept in settings; `cache` is the cache index keyed by API URL. The API
    URL is the cache identity: a missing index entry or a missing cache
    file is a miss, and the caller refetches through validation. The id in
    the entry is carried for the output payload and shuffle dedup only.
    """
    if not isinstance(saved, dict):
        return None
    if not api_src and is_remote_url(saved.get("src", "")):
        # Older settings stored the API URL directly in background.src.
        api_src = saved["src"]
    if not api_src:
        return None
    entry = cache.get(api_src)
    if not isinstance(entry, dict):
        return None
    restored = _local_background_dict(entry)
    if restored:
        return restored
    # Cache file is gone: drop the stale index entry so it can be refetched.
    cache.pop(api_src, None)
    save_background_cache(cache)
    return None


def _local_background_dict(entry):
    file_path = BACKGROUND_CACHE_DIR / str(entry.get("file", ""))
    if not file_path.is_file():
        return None
    result = {}
    if entry.get("id"):
        result["id"] = entry["id"]
    # Local file URL for the panel; the API URL lives in background_api_src.
    result["src"] = file_path.as_uri()
    if entry.get("author"):
        result["author"] = entry["author"]
    if entry.get("source"):
        result["source"] = entry["source"]
    return result


def write_cache_file(data_bytes, digest):
    """Atomically store validated GIF bytes; return the cache entry shape."""
    BACKGROUND_CACHE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    target = BACKGROUND_CACHE_DIR / f"{digest[:16]}.gif"
    temporary = target.with_suffix(".tmp")
    with open(temporary, "wb") as handle:
        handle.write(data_bytes)
    os.replace(temporary, target)
    return {"file": target.name}


def fetch_random_background():
    """Fetch one server-random pick from Plaza's background endpoint."""
    data = fetch_json(BACKGROUNDS_URL)
    # Live shape: {"data": {"id": ..., "src": ..., "author": ..., "source": ...}}.
    # The API randomizes server-side per call.
    item = data.get("data") if isinstance(data, dict) else None
    if not isinstance(item, dict):
        raise RuntimeError("Plaza backgrounds response has no data")
    result = clean_background(item)
    if not result:
        raise RuntimeError("Plaza backgrounds response has no image")
    return result


def fetch_json(url):
    request_obj = urllib.request.Request(
        url,
        headers={"User-Agent": "omarchy-nightwave-plaza/0.1", "Accept": "application/json"},
    )
    with urllib.request.urlopen(request_obj, timeout=3) as response:
        raw = response.read(MAX_STATUS_BYTES + 1)
    if len(raw) > MAX_STATUS_BYTES:
        raise RuntimeError("Plaza API response is too large")
    return json.loads(raw)


def publish_media_title(title):
    """Mirror the current track onto mpv's media-title for MPRIS clients."""
    if not title or not SOCKET_PATH.exists():
        return
    try:
        if get_property("force-media-title") == title:
            return
        request(["set_property", "force-media-title", title])
    except (OSError, RuntimeError, TimeoutError):
        # Metadata output must not depend on playback being alive.
        pass


def metadata():
    data = fetch_json(STATUS_URL)
    # Live shape: {"song": {"artist": ..., "title": ..., "album": ...,
    #   "length": ..., "position": ..., "artwork_sm_src": ...}, "listeners": N}.
    artist = ""
    track = ""
    album = ""
    artwork = ""
    length = 0
    position = 0
    song = data.get("song") if isinstance(data, dict) else None
    if isinstance(song, dict):
        artist = clean_text(song.get("artist"))
        track = clean_text(song.get("title"))
        album = clean_text(song.get("album"))
        artwork = clean_text(song.get("artwork_sm_src") or song.get("artwork_src"), 512)
        try:
            length = max(0, int(float(song.get("length", 0))))
        except (TypeError, ValueError):
            length = 0
        try:
            position = max(0, int(float(song.get("position", 0))))
        except (TypeError, ValueError):
            position = 0
    title = None
    if artist and track:
        title = artist + " - " + track
    else:
        title = artist or track or None
    if title is None:
        found = find_value(data, {"nowplaying", "now_playing", "track", "song", "title"})
        if isinstance(found, dict):
            found = find_value(found, {"title", "name"})
        if isinstance(found, str):
            title = clean_text(found)
    listeners = find_value(data, {"listeners", "listener_count", "listeners_count", "current_listeners"})
    result = {}
    if isinstance(title, str) and title.strip():
        result["title"] = title[:160]
    if artist:
        result["artist"] = artist
    if track:
        result["track"] = track
    if album:
        result["album"] = album
    if artwork:
        result["artwork"] = artwork
    if length > 0:
        result["length"] = length
        result["position"] = min(position, length)
    if isinstance(listeners, (int, float)) and listeners >= 0:
        result["listeners"] = int(listeners)
    if "title" in result:
        publish_media_title(result["title"])
    print(json.dumps(result, ensure_ascii=True))


def history():
    data = fetch_json(HISTORY_URL)
    # Live shape: {"songs": [{"artist": ..., "title": ..., "played_at": epoch}]}.
    songs = data.get("songs") if isinstance(data, dict) else None
    result = []
    if isinstance(songs, list):
        for song in songs[:HISTORY_LIMIT]:
            if not isinstance(song, dict):
                continue
            artist = clean_text(song.get("artist"))
            track = clean_text(song.get("title"))
            if not artist and not track:
                continue
            entry = {}
            if artist:
                entry["artist"] = artist
            if track:
                entry["track"] = track
            try:
                played_at = int(float(song.get("played_at", 0)))
            except (TypeError, ValueError):
                played_at = 0
            if played_at > 0:
                entry["played_at"] = played_at
            result.append(entry)
    print(json.dumps({"songs": result}, ensure_ascii=True))


def clean_background(item):
    """Normalize one background entry into the plugin's compact output shape."""
    if not isinstance(item, dict):
        return {}
    result = {}
    try:
        background_id = int(item.get("id", 0))
    except (TypeError, ValueError):
        background_id = 0
    if background_id > 0:
        result["id"] = background_id
    artwork = clean_text(item.get("src"), 512)
    if artwork:
        result["src"] = artwork
    author = clean_text(item.get("author"))
    if author:
        result["author"] = author
    source = clean_text(item.get("source"))
    if source:
        result["source"] = source
    if not result.get("src"):
        return {}
    return result


def same_background(saved, pick, api_src=""):
    """Report whether two picks describe the same image (by id, else by API src)."""
    if saved.get("id") and saved.get("id") == pick.get("id"):
        return True
    return bool(api_src and api_src == pick.get("src"))


def download_pick(pick):
    """Download, validate, and cache one pick; return its cache entry.

    The URL is fetched over HTTPS with redirects restricted to HTTPS, a
    timeout, and a hard size cap, then structurally validated as a GIF
    within the canvas/frame/pixel budget. Rejected bytes never become
    cache files. Raises on any failure.
    """
    remote_url = pick.get("src", "")
    if not is_remote_url(remote_url):
        raise RuntimeError("Plaza backgrounds response has no usable https image URL")
    image = fetch_image(remote_url)
    validate_gif(image)
    entry = write_cache_file(image, hashlib.sha256(image).hexdigest())
    if pick.get("id"):
        entry["id"] = pick["id"]
    if pick.get("author"):
        entry["author"] = pick["author"]
    if pick.get("source"):
        entry["source"] = pick["source"]
    return entry


def backgrounds(force_new=False):
    """Print one background pick as {id?, src, author?, source?}.

    The pick is remembered in settings.json, so a plain `backgrounds` call
    restores it from the local cache without a network request, and
    `backgrounds new` fetches a fresh server-random pick, retrying once when
    the endpoint repeats the image currently showing. The runtime directory
    is wiped on logout, so a fresh boot starts from one new fetch.

    The returned `src` is always a validated local file URL under the
    private runtime directory; the original API URL is kept separately in
    the `background_api_src` settings key for dedup and cache lookup. On
    failure (unreachable endpoint, redirect off HTTPS, oversized or
    malformed GIF) the call prints the error to stderr and exits nonzero,
    and the QML panel keeps its existing backdrop — empty/static on
    initial failure.
    """
    settings = load_settings()
    saved = clean_background(settings.get("background"))
    api_src = settings.get("background_api_src", "")
    if not isinstance(api_src, str):
        api_src = ""

    if not force_new:
        cached = lookup_cached_background(saved, api_src, load_background_cache())
        if cached:
            print(json.dumps(cached, ensure_ascii=True))
            return

    try:
        pick = fetch_random_background()
        if saved and same_background(saved, pick, api_src):
            pick = fetch_random_background()
        entry = download_pick(pick)
    except (OSError, RuntimeError, TimeoutError, ValueError, json.JSONDecodeError) as error:
        # A failed shuffle leaves the current backdrop in place; on initial
        # failure the panel's empty/static state persists.
        print(str(error), file=sys.stderr)
        sys.exit(1)

    cache = load_background_cache()
    cache[pick["src"]] = entry
    save_background_cache(cache)

    result = _local_background_dict(entry)
    if not result:
        print("nightwave: background cache file missing right after write", file=sys.stderr)
        sys.exit(1)

    settings["background"] = result
    settings["background_api_src"] = pick["src"]
    save_settings(settings)
    print(json.dumps(result, ensure_ascii=True))


def main(args):
    PLUGIN_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not args or args[0] == "status":
        print(json.dumps(state(), ensure_ascii=True))
    elif args[0] == "metadata":
        metadata()
    elif args[0] == "history":
        history()
    elif args[0] == "backgrounds":
        sub = args[1] if len(args) > 1 else ""
        if sub not in ("", "new"):
            raise RuntimeError("Usage: plaza-player backgrounds [new]")
        backgrounds(force_new=bool(sub))
    elif args[0] == "outputs":
        outputs()
    elif args[0] == "output":
        set_output(args[1] if len(args) > 1 else "")
    elif args[0] == "toggle":
        toggle()
    elif args[0] == "play":
        start_stream()
    elif args[0] == "stop":
        stop()
    elif args[0] == "volume" and len(args) == 2:
        volume = max(0, min(100, int(args[1])))
        launch(play_stream=False)
        request(["set_property", "volume", volume])
    else:
        raise RuntimeError("Usage: plaza-player {status|metadata|history|backgrounds [new]|outputs|output [SINK]|toggle|play|stop|volume N}")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
